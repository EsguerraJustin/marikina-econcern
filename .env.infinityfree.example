# Marikina E-Concern — InfinityFree .env template
# Copy these values into InfinityFree > File Manager > htdocs/.env
# (or htdocs/<subfolder>/.env). NEVER commit real values to git.

APP_NAME="E-Concern"

# Deploy at domain ROOT: leave empty. Subfolder deploy: "/foldername" (no %20, no trailing slash).
APP_BASE_URL=""

# MUST be your public https origin (no trailing slash). Add subfolder path if not at root.
APP_PUBLIC_URL="https://your-account.infinityfreeapp.com"

DB_HOST=sqlXXX.infinityfree.com
DB_USER=ifo_XXXXXXXX
DB_PASS=your-db-password
DB_NAME=ifo_XXXXXXXX_econcern

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_FROM_ADDRESS=no-reply@your-domain
MAIL_FROM_NAME="Marikina E-Concern"
BREVO_API_KEY=

SMS_PROVIDER=textbee
SMS_TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
SMS_TEXTBEE_ENDPOINT=https://api.textbee.dev/api/v1/gateway/send-sms
SMS_TEXTBEE_API_KEY=
SMS_TEXTBEE_DEVICE_ID=
SMS_SENDER=MarikinaCG

# Empty = local_disk mode (uploads stay on InfinityFree, counts vs 5GB quota).
# Set all 3 to use Cloudinary CDN instead (recommended for production photos).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

CALENDARIFIC_API_KEY=
OPENWEATHER_API_KEY=

# Leave EMPTY (disables web recovery). Use only for first admin creation if needed.
SETUP_RECOVERY_KEY=

MOCK_EMAIL_FAIL_PCT=0
MOCK_WEATHER_FIXTURE=sunny-2-day
MOCK_HOLIDAY_FIXTURE=split-2026
MOCK_GEOCODING_MODE=valid
MOCK_IMAGE_STORAGE_MODE=local_disk
MOCK_SMS_FAIL_PCT=0
