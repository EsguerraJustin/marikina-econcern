# Marikina E-Concern — Environment Template
# Copy to .env and fill with real values. NEVER commit .env to git.
# Local XAMPP defaults are shown; production (InfinityFree) values differ.

APP_NAME="E-Concern"
# Store WITHOUT %20 — helpers.php encodes spaces automatically
APP_BASE_URL="/Marikina Concern/Marikina Concern"
# Public origin embedded in emailed verification + password-reset links.
# Local XAMPP: keep the localhost value below so links open on this machine.
# Production: MUST be the public origin (no trailing slash), e.g.
# APP_PUBLIC_URL="https://your-domain.example"
# (add the subfolder path too if the app lives in one).
# Links already emailed keep the host they were generated with — resend the
# verification/reset email after changing this.
APP_PUBLIC_URL="http://localhost/Marikina%20Concern/Marikina%20Concern"

# --- Database ---
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=e_concern

# --- Email (Brevo) ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Marikina E-Concern"
BREVO_API_KEY=

# --- SMS (TextBee) ---
SMS_PROVIDER=textbee
SMS_TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
SMS_TEXTBEE_ENDPOINT=https://api.textbee.dev/api/v1/gateway/send-sms
SMS_TEXTBEE_API_KEY=
SMS_TEXTBEE_DEVICE_ID=
SMS_SENDER=MarikinaCG

# --- Cloudinary (set to empty to keep local_disk mode) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# --- External APIs ---
CALENDARIFIC_API_KEY=
OPENWEATHER_API_KEY=

# --- Admin Recovery (leave EMPTY to disable web-based admin recovery) ---
# Gates admin/setup.php recovery + create-super-admin. Without it, the only way
# to re-enable a disabled/locked admin is:  php bin/recover_admin.php --list
# Generate a key with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
SETUP_RECOVERY_KEY=

# --- Mocks (0 = live, fixtures) ---
MOCK_EMAIL_FAIL_PCT=0
MOCK_WEATHER_FIXTURE=sunny-2-day
MOCK_HOLIDAY_FIXTURE=split-2026
MOCK_GEOCODING_MODE=valid
MOCK_IMAGE_STORAGE_MODE=local_disk
MOCK_SMS_FAIL_PCT=0

# --- Production InfinityFree (uncomment when deploying) ---
# 2026-09-27: the real host / user / password / database name that were sitting
# here as live values are now placeholders. This file is 403-blocked by
# .htaccess, but it is explicitly un-ignored in .gitignore and therefore
# committed to version control, so a commented-out line is still a published
# credential. Put the real values in the deployment environment or in a local
# .env, never in this template.
# APP_PUBLIC_URL=https://your-domain.example/
# DB_HOST=your-db-host
# DB_USER=your-db-user
# DB_PASS=your-db-password
# DB_NAME=your-db-name
