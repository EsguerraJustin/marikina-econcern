# --- Marikina E-Concern .gitignore ---

# Secrets / env
.env
!.env.example

# Uploads (user content â€” never commit)
uploads/
!uploads/.gitkeep

# Logs
app_error.log
*.log
storage/logs/
storage/cache/
storage/qa_harnesses/_tmp_sessions/

# QA harnesses â€” debug scripts, not production
storage/qa_harnesses/
!storage/qa_harnesses/README.md

# Mocks / fixtures that bloat VCS (keep seed JSON but ignore generated mocks)
storage/mock_emails/
storage/mock_images/
storage/mock_geocoding/*.log
storage/fixtures/qa_test_*
storage/fixtures/tmp_qa_*
storage/fixtures/images/qa_test_*
storage/fixtures/images/tmp_qa_*

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# Composer
vendor/
composer.lock

# Node (for future Capacitor)
node_modules/
npm-debug.log
dist/
capacitor.config.json.bak

# InfinityFree deploy artifact
deploy.zip
deploy.zip.zip
marikina-econcern-source.zip

# Android / TWA build (generated by bin/build_apk_project.js + bubblewrap build).
# Local-only: built on the dev machine, never served, never deployed.
apk/
apk-admin/
*.jks
*.keystore

# Repomix
repomix-output.xml

# Internal documentation â€” PROJECT_GUIDE.md is a developer document that
# documents the credential layout. It must never be committed. The .htaccess
# blocks *.md from being served, which is what protects the deployed site; the
# repo itself is expected to carry README.md and docs/.
PROJECT_GUIDE.md
# ...but the systems reference in docs/ carries no credentials - that is
# re-asserted on every test run by
# SecurityHardeningTest::test_project_guide_carries_no_live_secret_values - and it
# is meant to be readable, so it is explicitly un-ignored. The rule above matches
# at any depth, so without this line docs/PROJECT_GUIDE.md would be excluded too.
!docs/PROJECT_GUIDE.md

# Temp
tmp/
temp/
*.tmp
*.temp

# Agent tool config (231 files, 1.4MB) - not part of the application
.claude/
